# AlastreSystem - plantilla de configuracion
# Copia este archivo como .env y rellena los valores de tu maquina.
# El .env real NUNCA se sube al repositorio (ver .gitignore).

APP_NAME=AlastreSystem
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/AlastreSystem

# Base de datos (valores por defecto de XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alastresystem
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
