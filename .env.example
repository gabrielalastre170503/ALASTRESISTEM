# AlastreSystem - plantilla de configuracion
# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio (ver .gitignore).

APP_NAME=AlastreSystem
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/AlastreSystem

# --- Google Places API (obligatoria para bin/scout.php) --------------------
# console.cloud.google.com -> habilitar "Places API (New)" -> crear clave.
# Requiere facturacion activa, pero trae credito inicial gratuito.
# Restringe la clave a la Places API antes de usarla en serio.
GOOGLE_PLACES_API_KEY=

# Idioma de los resultados de Places.
PLACES_IDIOMA=es

# --- PageSpeed Insights (opcional para bin/auditar.php) -------------------
# Misma consola, habilitar "PageSpeed Insights API". Es gratuita: la clave
# solo sube la cuota diaria. Sin ella el auditor omite la medida de velocidad.
GOOGLE_PSI_API_KEY=

# --- Envio (todavia no se usa; llega en la Fase 3) ------------------------
# Buzon propio de Google Workspace sobre un dominio aparte del principal.
# No uses SendGrid ni Mailgun para correo en frio: su politica de uso
# aceptable lo prohibe y te cierran la cuenta.
REMITENTE_EMAIL=
REMITENTE_NOMBRE=
